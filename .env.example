# Crawl4AI API Configuration

# Optional API security token
CRAWL4AI_API_TOKEN=

# Maximum concurrent crawl tasks
MAX_CONCURRENT_TASKS=5

# Server configuration
HOST=0.0.0.0
PORT=8004

# LLM Provider Keys (optional, for advanced crawl4ai features)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ======================================
# Communication Configuration
# ======================================
# =========================
# Communication
# =========================
COMMUNICATION_ENABLED=true
COMMUNICATION_METHOD=rabbitmq

# =========================
# RabbitMQ connection
# =========================
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_HEARTBEAT=30
RABBITMQ_CONNECTION_TIMEOUT=30

# =========================
# Producer behavior
# =========================
RABBITMQ_PUBLISHER_CONFIRMS=true
RABBITMQ_PERSISTENT_MESSAGES=true
RABBITMQ_MANDATORY_PUBLISH=true

# =========================
# Main job exchange
# =========================
RABBITMQ_EXCHANGE=jobs
RABBITMQ_EXCHANGE_TYPE=direct
RABBITMQ_MAIN_ROUTING_KEY=crawl

# =========================
# Shared job schema
# =========================
JOB_SCHEMA_VERSION=1

# =========================
# Optional producer metadata
# =========================
JOB_SOURCE=crawler
JOB_DEFAULT_MAX_RETRIES=3