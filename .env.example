# Crawl4AI API Configuration

# Optional API security token
CRAWL4AI_API_TOKEN=

# Maximum concurrent crawl tasks
MAX_CONCURRENT_TASKS=5

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text
JOB_LOG_FILE_LEVEL=ERROR

# Server configuration
HOST=0.0.0.0
PORT=8004

# LLM Provider Keys (optional, for advanced crawl4ai features)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ======================================
# Communication Configuration
# ======================================
# =========================
# Communication
# =========================
COMMUNICATION_ENABLED=true
COMMUNICATION_METHOD=rabbitmq

# Optional decoupling:
# Keep pipeline file-event publishing on RabbitMQ while disabling legacy progress queues.
# FILE_EVENTS_ENABLED=true
# FILE_EVENTS_TRANSPORT=rabbitmq

# =========================
# RabbitMQ connection
# =========================
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_HEARTBEAT=30
RABBITMQ_CONNECTION_TIMEOUT=30

# =========================
# Producer behavior
# =========================
RABBITMQ_PUBLISHER_CONFIRMS=true
RABBITMQ_PERSISTENT_MESSAGES=true
RABBITMQ_MANDATORY_PUBLISH=true

# =========================
# Pipeline events exchange
# =========================
RABBITMQ_EVENTS_EXCHANGE=pipeline.events
RABBITMQ_EVENTS_EXCHANGE_TYPE=direct
RABBITMQ_FILE_DISCOVERED_ROUTING_KEY=scrape.file.discovered

# =========================
# Main job exchange
# =========================
RABBITMQ_EXCHANGE=jobs
RABBITMQ_EXCHANGE_TYPE=direct
RABBITMQ_MAIN_ROUTING_KEY=crawl

# =========================
# Shared job schema
# =========================
JOB_SCHEMA_VERSION=1

# =========================
# Optional producer metadata
# =========================
JOB_SOURCE=scraper
JOB_DEFAULT_MAX_RETRIES=3

# Optional: write skipped/failed file events to JSONL for debugging
FILE_EVENT_OUTBOX_PATH=
