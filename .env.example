# Crawl4AI API Configuration

# Optional API security token
CRAWL4AI_API_TOKEN=

# Maximum concurrent crawl tasks
MAX_CONCURRENT_TASKS=5

# Server configuration
HOST=0.0.0.0
PORT=8004

# LLM Provider Keys (optional, for advanced crawl4ai features)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ======================================
# Communication Configuration
# ======================================

# Communication method: "redis", "rabbitmq", or "none"
# Default: redis
COMMUNICATION_METHOD=redis

# Enable/disable communication
# Default: true
COMMUNICATION_ENABLED=true

# Redis Configuration (when COMMUNICATION_METHOD=redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_CHANNEL=scrape-events

# RabbitMQ Configuration (when COMMUNICATION_METHOD=rabbitmq)
# Requires: pip install aio-pika
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_EXCHANGE=scrape-events
# RABBITMQ_QUEUE=  # Optional, defaults to job-{job_id}
