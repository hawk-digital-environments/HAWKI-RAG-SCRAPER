# Crawl4AI API Configuration

# Maximum concurrent crawl tasks
MAX_CONCURRENT_TASKS=5

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text
JOB_LOG_FILE_LEVEL=ERROR

# Container user/group for mounted writable paths.
# Match these to the owner of rawki_shared_storage and ./profiles.
PUID=1000
PGID=1000

# LLM Provider Keys (optional, for advanced crawl4ai features)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Data storage path for job files
DATA_PATH=/var/www/html/shared
