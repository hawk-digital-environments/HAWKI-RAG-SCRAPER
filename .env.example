# Crawl4AI API Configuration

# Optional API security token
CRAWL4AI_API_TOKEN=

# Maximum concurrent crawl tasks
MAX_CONCURRENT_TASKS=5

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text
JOB_LOG_FILE_LEVEL=ERROR

# LLM Provider Keys (optional, for advanced crawl4ai features)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Data storage path for job files
DATA_PATH=/var/www/html/shared
