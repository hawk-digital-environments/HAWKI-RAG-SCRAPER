## ============================================================
## Required Settings (fill in before the first start)
## ============================================================

# Optional API security token: clients must present it on every API request.
# Generate a fresh value with
#   ./generate-env-secrets.sh
# and paste the printed block over the empty value here (or into your .env).
# Leave it empty to run the API without authentication - only acceptable
# behind a trusted proxy that handles access control itself.
CRAWL4AI_API_TOKEN=

## ============================================================
## Deployment (production only)
## ============================================================

# The HAWKI RAG Scraper version to deploy. The image pulled by this stack is
# pinned through this value; `latest` follows the newest release tag. Set it
# to the exact version (matching the Docker Hub tags) for reproducible
# deployments: latest, <major> or <version>.
#
# Our own servers do not use these public Docker Hub releases: the
# deploy-scraper-*.yml workflows build the internal deployment images and
# push them to the GitHub Container Registry as <environment>-latest. A
# Dokploy deployment therefore sets:
#   HAWKI_RAG_SCRAPER_IMAGE_REPOSITORY=ghcr.io/hawk-digital-environments/customcrawler
#   HAWKI_RAG_SCRAPER_VERSION=prod-latest   # or: test-1-latest
HAWKI_RAG_SCRAPER_VERSION=latest
HAWKI_RAG_SCRAPER_IMAGE_REPOSITORY=digitalenvironments/hawki-rag-scraper

# Host port the scraper binds to (an external reverse proxy should forward
# its traffic here) and the interface to bind on.
HAWKI_RAG_SCRAPER_PORT=8041
DOCKER_PROJECT_IP=127.0.0.1

# Public URL that reaches the UI. The SvelteKit frontend validates the
# Origin header of unsafe requests against this value and uses it to build
# absolute links. Keep the localhost default only for local trials; behind a
# TLS-terminating reverse proxy set it to the full public URL, e.g.
#   ORIGIN=https://scraper.example.com
ORIGIN=http://localhost:8041

## ============================================================
## Application
## ============================================================

# Maximum concurrent crawl tasks
MAX_CONCURRENT_TASKS=5

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text
JOB_LOG_FILE_LEVEL=ERROR

# Data storage path for job files. The default writes into the shared volume
# (rawki_shared_storage) that the HAWKI RAG stack reads crawled data from.
DATA_PATH=/var/www/html/shared

# LLM Provider Keys (optional, for advanced crawl4ai features)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

## ============================================================
## Docker Compose and Container Adapters
## ============================================================

# Container user/group for the writable volumes.
# Match these to the owner of rawki_shared_storage.
PUID=33
PGID=33

## ============================================================
## Advanced (working defaults are baked into the image)
## ============================================================

# The variables below have production-ready defaults inside the image (see
# docker/custom/env/10-service.env); only set them to change the internal
# wiring of the container.
#
# PUBLIC_API_BASE_URL=/ui                      # public path of the UI; must
#                                              # match the value the image was
#                                              # BUILT with (see the
#                                              # PUBLIC_API_BASE_URL build arg
#                                              # in the Dockerfile)
# CRAWLER_API_BASE_URL=http://localhost:80     # where the UI server finds the
#                                              # crawler API (internal)
# NODE_SERVICE_PORT=3000                       # internal port of the UI server
