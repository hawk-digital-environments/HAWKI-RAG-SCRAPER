# Version control / CI
.git/
.gitignore
.gitattributes
.github/
_changelog

# Python build artifacts
**/__pycache__/
*.py[cod]
**/*.py[cod]
*$py.class
*.so
.Python
**/*.egg-info/
dist/
build/

# Virtual environments (any local setup)
env/
venv/
ENV/
crawl4ai-env/
**/.venv/

# IDE / editor / OS droppings
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.log

# Testing scratch files at the repo root
test*.py

# Documentation (not needed inside the container)
*.md
!README.md

# Node / UI local build state - must not leak into the build context, where
# it would bloat transfers and invalidate the COPY layers on every local
# install/build
ui/node_modules/
ui/.svelte-kit/
ui/build/
ui/.env*

# Output data (mounted as volume at runtime)
output/
shared/

# Runtime data that is mounted into the container at runtime, never baked
# into the image
profiles/
tasks/

# Environment files (builds get their values from build args instead)
.env
.env.local

# Docker / compose definitions not needed inside the image
Dockerfile
docker-compose.yml
.dockerignore
