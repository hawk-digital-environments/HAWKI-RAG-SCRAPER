{
  "name": "example_university",
  "match_hosts": [
    "example.edu",
    "*.example.edu"
  ],
  "discovery": {
    "allowed_hosts": [
      "example.edu"
    ]
  },
  "forbidden": {
    "hosts": [
      "login.example.edu",
      "mail.example.edu",
      "idp.example.edu",
      "moodle.example.edu"
    ],
    "url_patterns": [
      "/contact",
      "/privacy",
      "/imprint"
    ]
  },
  "content": {
    "content_selectors": [
      "main",
      "article",
      "[role='main']",
      ".content",
      ".main-content"
    ],
    "noise_phrases": [
      "share this page",
      "follow us",
      "cookie settings",
      "privacy settings"
    ],
    "noise_patterns": [
      "breadcrumb",
      "sidebar",
      "share",
      "footer",
      "cookie"
    ],
    "tag_selectors": [
      "meta[property='article:tag']",
      "meta[name='keywords']"
    ]
  },
  "sitemap": {
    "enabled": true,
    "base_url": "https://www.example.edu/sitemap.xml",
    "start_page": 1,
    "pages": 3,
    "table_selector": "table",
    "headers": {
      "url": ["url", "page"],
      "last_modified": ["last modified", "updated", "lastmod"],
      "language": ["language", "lang"]
    },
    "lang_from_url_regex": "^https?://[^/]+/(en|de|fr)(?:/|$)",
    "language_prefixes": {
      "en": "EN",
      "de": "DE",
      "fr": "FR"
    },
    "output_path": "data/example_university_sitemap.json"
  }
}
