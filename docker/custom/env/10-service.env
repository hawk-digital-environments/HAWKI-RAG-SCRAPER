# Service-level defaults, loaded by the neunerlei entrypoint before any
# service is configured. Each line only applies its default when the
# variable is not already set, so `docker run -e` / compose `environment:`
# entries always win without a rebuild.
#
# NOTE on PUBLIC_API_BASE_URL: the UI bundle ALSO bakes this value in at
# build time (SvelteKit paths.base and $env/static/public, see the
# PUBLIC_API_BASE_URL build arg in the Dockerfile). Keep the runtime value
# in sync with the one the image was built with.

# Public path the SvelteKit UI is served under (nginx proxies it to the
# adapter-node service).
PUBLIC_API_BASE_URL=${PUBLIC_API_BASE_URL:-/ui}

# Where the SvelteKit server finds the crawler API (same container, nginx).
CRAWLER_API_BASE_URL=${CRAWLER_API_BASE_URL:-http://localhost:80}

# Port of the internal adapter-node service (nginx proxies to it).
NODE_SERVICE_PORT=${NODE_SERVICE_PORT:-3000}

# Public origin the adapter-node service validates against (CSRF check).
# Set this to the real public URL when deploying behind https/proxies.
ORIGIN=${ORIGIN:-http://localhost:80}
