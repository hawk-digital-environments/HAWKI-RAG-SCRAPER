# Loaded before nginx templates and the frontend supervisor configuration.
# Preserve deployment overrides while providing the default internal routing.
NODE_SERVICE_PORT=${NODE_SERVICE_PORT:-3000}
PUBLIC_API_BASE_URL=${PUBLIC_API_BASE_URL:-/ui}
CRAWLER_API_BASE_URL=${CRAWLER_API_BASE_URL:-http://127.0.0.1:80}
ORIGIN=${ORIGIN:-http://localhost:80}
