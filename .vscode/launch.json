{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug FastAPI",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "src.app.main:app",
        "--port",
        "8000",
        "--host",
        "0.0.0.0",
        "--reload",
        "--log-level",
        "debug"
      ],
      "env": {        "DATA_PATH": "/tmp/bar"},
      "console": "integratedTerminal"
    },
    {
      "name": "pytest",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "module": "pytest",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "args": [
        "-vvv",
      ],
      "env": {}
    },
        {
      "name": "crawl-example-client-1",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "program": "${workspaceFolder}/examples/example_client.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "args": [
        "1",
      ],
      "env": {

      }
    }
  ]
}